# ISOLATED PREVIEW TEMPLATE ONLY. preview.example.com is a placeholder, NOT an approved or deployed Ootla hostname.
# Replace it with an authorized HTTPS preview hostname before use. Keep NODE_ENV=development.
# This file provisions nothing. Never connect it to customer data or copy customer credentials.

# Environment selection is server-only. Set OOTLA_ENV_FILE in the launcher before startup
# to select an absolute private file. A blank value does not select a file from inside itself.
# Production reads an explicitly selected file or preloaded process variables; it never falls back to .env.
OOTLA_ENV_FILE=/etc/ootla/preview.env

# Runtime and HTTP boundary. The same API process runs all seven bounded durable workers.
# No separate worker daemon is needed. Startup never migrates, seeds or resets data.
NODE_ENV=development
SERVE_COMPILED_CLIENT=true
PORT=3100
OOTLA_BIND_HOST=127.0.0.1
APP_URL=https://preview.example.com
COOKIE_SECURE=true
TRUST_PROXY_LOOPBACK=true

# Private database URL. URL-encode the password; never use VITE_* for server settings.
# Use separate customer/preview databases AND roles. Never grant the preview role customer access.
# Local PostgreSQL may use disable. A remote production connection requires verify-full.
# Blank CA file uses trusted system roots; custom CA files must be absolute private PEM paths.
# DATABASE_URL must not contain sslmode or other conflicting TLS query settings.
DATABASE_URL=postgresql://ootla_preview:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/ootla_demo_preview
DATABASE_TLS_MODE=disable
DATABASE_TLS_CA_FILE=

# A new random secret is required per runtime. Never copy customer secrets to the preview.
# Host-prefixed names require HTTPS; cookies remain host-only with no shared Domain.
# PREVIEW_APP_URL selects only a separate preview origin, never a query-supplied target.
SESSION_SECRET=REPLACE_WITH_A_NEW_RANDOM_PREVIEW_SECRET_OF_AT_LEAST_32_CHARACTERS
SESSION_COOKIE_PREFIX=__Host-ootla_preview
PREVIEW_APP_URL=

# Demo accounts are deliberately seeded only in a verified ootla_demo or ootla_demo_* database.
# These public preview credentials are ignored when DEMO_MODE=false; no customer account is created.
# Seeding/resetting is never part of ordinary startup.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@demo.ootla.test
DEMO_ADMIN_PASSWORD=OotlaDemo!2026

# Existing connector/outbound safety modes. Unknown live transports remain unavailable.
# The simulator needs no provider credentials. A blank encryption key disables credential storage.
# When needed, generate a separate base64 32-byte key; preserve it for saved-token decryption.
INTEGRATIONS_MODE=simulation
OUTBOUND_MODE=simulation
CONNECTOR_CREDENTIAL_KEY=

# AI is optional. Production starts disabled; isolated previews may use simulated.
# Live OpenAI requires an explicit model/key, positive budgets and operator-verified token prices.
# Cost micros are millionths of USD. Zero price placeholders never authorize live inference.
AI_PROVIDER=simulated
AI_MODEL=
AI_API_KEY=
AI_MAX_REQUESTS_PER_MINUTE=20
AI_MAX_TOKENS_PER_REQUEST=16000
AI_DAILY_TOKEN_BUDGET=200000
AI_DAILY_COST_BUDGET_MICROS=1000000
AI_INPUT_COST_MICROS_PER_MILLION=0
AI_OUTPUT_COST_MICROS_PER_MILLION=0
AI_TIMEOUT_MS=8000

# Optional Google Calendar. Keep disabled in every demo. Activate only after authorized OAuth setup.
# Redirect URI must exactly equal APP_URL + /api/google-calendar/oauth/callback.
# Use a separate random base64 32-byte token key; never commit real credentials.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_KEY=

# Optional read-only Google Analytics. Keep disabled in every demo.
# Redirect URI must exactly equal APP_URL + /api/google-analytics/oauth/callback.
# Enable the official Data/Admin APIs and preserve a separate token encryption key when activating.
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REDIRECT_URI=
GOOGLE_ANALYTICS_TOKEN_KEY=

# Public marketing build settings: non-secret, allowlisted for the website build.
# ootla.ai is the confirmed production domain. Keep indexing off for local and preview builds.
# Change indexing only for a reviewed public launch; changing runtime values does not rebuild pages.
PUBLIC_SITE_URL=https://preview.example.com
PUBLIC_SITE_INDEXING=false

# Private applicant, resident and property documents are authorized PostgreSQL bytea.
# Back up the complete database; there is no public uploads folder or storage-provider variable.
# Voice stays disabled per organization until deliberate authorized configuration.
# No telephony, recording, SMS, email, Yardi or payment-provider credentials are invented here.
# Apply additive migrations deliberately before compiled startup; preserve existing records.
