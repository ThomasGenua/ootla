[Unit]
Description=Ootla isolated online demo (API, compiled site and durable workers)
After=network.target postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ootla
Group=ootla
WorkingDirectory=/srv/ootla/app
EnvironmentFile=/srv/ootla/app/.env
# Replace /usr/bin/node if command -v node reports another system-wide path.
ExecStart=/usr/bin/node /srv/ootla/app/dist/server/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Private documents and jobs are persisted in PostgreSQL, not a writable public folder.

[Install]
WantedBy=multi-user.target