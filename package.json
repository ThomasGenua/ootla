{
  "name": "ootla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "node scripts/dev-client.mjs",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "env:setup": "node scripts/setup-env.mjs",
    "check:foundation": "tsx scripts/check-foundation.ts",
    "check:browser": "node scripts/check-browser.mjs",
    "check:auth": "tsx scripts/check-auth.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "check:demo": "tsx scripts/check-demo.ts",
    "check:demo:restart": "node scripts/check-demo-restart.mjs",
    "check:dashboard": "tsx scripts/check-dashboard.ts",
    "check:homepage": "node scripts/check-homepage.mjs",
    "check:public-workflows": "node scripts/check-public-workflows.mjs",
    "check:public-platform": "node scripts/check-public-platform.mjs",
    "demo:volume": "tsx scripts/seed-property-volume.ts",
    "check:properties": "tsx scripts/check-property-foundation.ts",
    "check:property-browser": "node scripts/check-property-browser.mjs",
    "check:leads": "tsx scripts/check-leads.ts",
    "check:lead-browser": "tsx scripts/check-lead-browser-isolated.ts",
    "check:lead-browser:preview": "node scripts/check-lead-browser.mjs",
    "check:lead-workspace": "tsx scripts/check-lead-workspace.ts",
    "check:lead-workspace-browser": "tsx scripts/check-lead-workspace-browser-isolated.ts",
    "check:lead-workspace-browser:preview": "node scripts/check-lead-workspace-browser.mjs",
    "check:tasks": "tsx scripts/check-tasks.ts",
    "check:tasks-browser": "tsx scripts/check-tasks-browser-isolated.ts",
    "check:tasks-browser:preview": "node scripts/check-tasks-browser.mjs",
    "reminders:process": "tsx scripts/process-task-reminders.ts",
    "demo:standalone": "tsx scripts/seed-standalone-demo.ts",
    "check:imports": "tsx scripts/check-imports.ts",
    "check:imports-browser": "tsx scripts/check-imports-browser-isolated.ts",
    "check:imports-browser:preview": "node scripts/check-imports-browser.mjs",
    "imports:process": "tsx scripts/process-imports.ts",
    "check:login-origin": "node scripts/check-login-origin.mjs",
    "check:account": "tsx scripts/check-account.ts",
    "check:account-browser": "tsx scripts/check-account-browser-isolated.ts",
    "check:account-browser:preview": "node scripts/check-account-browser.mjs",
    "connectors:process": "tsx scripts/process-connectors.ts",
    "check:connectors": "tsx scripts/check-connectors.ts",
    "check:connectors-browser": "tsx scripts/check-connectors-browser-isolated.ts",
    "check:connectors-browser:preview": "node scripts/check-connectors-browser.mjs",
    "check:yardi": "tsx scripts/check-yardi.ts",
    "check:yardi-browser": "tsx scripts/check-yardi-browser-isolated.ts",
    "check:yardi-browser:preview": "node scripts/check-yardi-browser.mjs",
    "google-calendar:process": "tsx scripts/process-google-calendar.ts",
    "check:google-calendar": "tsx scripts/check-google-calendar.ts",
    "check:google-calendar-browser": "node scripts/check-google-calendar-browser.mjs",
    "demo:applicant": "tsx scripts/seed-applicant-demo.ts",
    "check:applicant-portal": "tsx scripts/check-applicant-portal.ts",
    "check:applicant-browser": "tsx scripts/check-applicant-browser-isolated.ts",
    "check:public-seo": "node scripts/check-public-seo.mjs",
    "check:application-journey": "tsx scripts/check-application-journey.ts",
    "check:screening-browser": "tsx scripts/check-screening-browser-isolated.ts",
    "check:payment-browser": "tsx scripts/check-payment-browser-isolated.ts",
    "check:lease-browser": "tsx scripts/check-lease-browser-isolated.ts",
    "check:pilot": "tsx scripts/check-pilot.ts",
    "check:pilot-browser": "tsx scripts/check-pilot-browser-isolated.ts",
    "check:backup": "tsx scripts/check-backup.ts",
    "check:release": "tsx scripts/check-release.ts",
    "setup:organization": "tsx scripts/setup-organization.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "pg": "8.23.1",
    "svix": "2.9.1",
    "twilio": "6.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
