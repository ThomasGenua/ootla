# Server-only configuration. Never rename these to VITE_*.
# npm run env:setup creates .env with random local secrets, without overwriting it.
NODE_ENV=development
DATABASE_URL=postgresql://ootla:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@127.0.0.1:55439/ootla_demo
PORT=3100
APP_URL=http://127.0.0.1:7674
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Demo mode is allowed only outside production and against ootla_demo or ootla_demo_*.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@demo.ootla.test
DEMO_ADMIN_PASSWORD=OotlaDemo!2026

# Existing Yardi/demo integrations and outbound notifications stay in simulation.
# Google Calendar has its own explicit non-demo opt-in below; demo always blocks it.
INTEGRATIONS_MODE=simulation
OUTBOUND_MODE=simulation

# Optional server-only base64-encoded random 32-byte key for encrypted connector credentials.
# The Yardi simulator needs no credentials. Blank disables credential storage.
# Generate when needed: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key outside source control; do not rotate without re-encrypting saved credentials.
CONNECTOR_CREDENTIAL_KEY=

# Stage 14 Google Calendar: optional, server-only. Demo must stay disabled.
# Enable only in a separate non-demo environment after Cloud/OAuth setup.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Exact APP_URL + /api/google-calendar/oauth/callback (no trailing slash).
GOOGLE_CALENDAR_REDIRECT_URI=
# Separate random base64 32-byte key; preserve securely for saved-token decryption.
GOOGLE_CALENDAR_TOKEN_KEY=

# Public marketing SEO (build-time, non-secret). Leave indexing off for previews.
# Set the verified production HTTPS origin before building for a public launch.
PUBLIC_SITE_URL=
PUBLIC_SITE_INDEXING=false

# Optional reviewed assistant drafts. Demo uses labeled templates and never calls AI.
# Both server configuration and an organization administrator's opt-in are required.
# Set a model available to your OpenAI project; there is no implicit paid default.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Reviewed email / SMS. Independent of legacy OUTBOUND_MODE=simulation.
# Leave off for demos. Live delivery requires HTTPS APP_URL and one live organization.
COMMUNICATIONS_ENABLED=false
COMMUNICATIONS_ORGANIZATION_ID=
# Email: configure a verified sender, inbound reply domain and signed webhooks.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=
# SMS: configure a messaging-capable sender and signed inbound/status webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
